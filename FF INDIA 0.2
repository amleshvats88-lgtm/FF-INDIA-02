<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#7559ff">
<link rel="manifest" href="manifest.json">
<title>ChatGPT 0.2</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#101426;
 color:white;
}
header{
 background:#7559ff;
 padding:20px;
 text-align:center;
 font-size:24px;
 font-weight:bold;
}
.container{padding:15px}
.card{
 background:#202943;
 padding:15px;
 border-radius:14px;
 margin-bottom:15px;
}
h3{margin-top:0;color:#b9aaff}
button{
 background:#7559ff;
 color:white;
 border:0;
 padding:12px;
 border-radius:9px;
 margin:5px 2px;
 font-size:15px;
}
input,textarea{
 width:100%;
 padding:12px;
 border-radius:9px;
 border:0;
 margin:7px 0;
 background:#eef0fa;
 color:#111;
}
textarea{min-height:90px}
#output{
 background:#151d32;
 padding:12px;
 border-radius:9px;
 min-height:45px;
 white-space:pre-wrap;
 ove{
  "name": "ChatGPT 0.2",
  "short_name": "ChatGPT",
  "description": "My ChatGPT 0.2 Demo App",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#101426",
  "theme_color": "#7559ff"
}const CACHE_NAME = "chatgpt-02-v1";

const FILES_TO_CACHE = [
  "./",
  "./index.html",
  "./manifest.json"
];

// ऐप इंस्टॉल होने पर फाइलें Cache में सेव होंगी
self.addEventListener("install", event => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => {
      return cache.addAll(FILES_TO_CACHE);
    })
  );

  self.skipWaiting();
});

// पुराने Cache को हटाना
self.addEventListener("activate", event => {
  event.waitUntil(
    caches.keys().then(cacheNames => {
      return Promise.all(
        cacheNames
          .filter(name => name !== CACHE_NAME)
          .map(name => caches.delete(name))
      );
    })
  );

  self.clients.claim();
});

// इंटरनेट न होने पर Cache से फाइल खोलना
self.addEventListener("fetch", event => {
  if (event.request.method !== "GET") return;

  event.respondWith(
    caches.match(event.request).then(cachedFile => {
      return cachedFile || fetch(event.request);
    })
  );
});